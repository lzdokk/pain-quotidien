# ── Supabase ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # secret, jamais cote client

# ── Modele de langue ────────────────────────────────────────────────
# gemini    Google AI Studio, GRATUIT, 1500 requetes/jour, sans carte
# groq      Groq, GRATUIT, 1000 requetes/jour
# mistral   Mistral, GRATUIT, environ 1 milliard de tokens/mois
# cerebras  Cerebras, GRATUIT, environ 1 million de tokens/jour
# anthropic Claude, PAYANT, meilleure qualite
# none      aucun appel automatique, contenu importe a la main
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

GOOGLE_AI_KEY=          # aistudio.google.com, cle gratuite en 30 secondes
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# ANTHROPIC_API_KEY=

# ── Garde-fous de consommation ──────────────────────────────────────
AI_ASSISTANT=on         # 'off' = base de questions seule, cout garanti nul
AI_DAILY_LIMIT=8        # questions par utilisateur et par jour
AI_GLOBAL_DAILY_CAP=400 # plafond absolu du site, tous utilisateurs confondus

# ── E-mails (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=re_...
MAIL_FROM="Le Pain quotidien <bonjour@painquotidien.app>"

# ── Securite des crons ──────────────────────────────────────────────
CRON_SECRET=            # openssl rand -hex 32

# ── Notifications push (OneSignal, Web Push) ────────────────────────
# App ID = public (cote navigateur). REST Key = SECRET (cote serveur seul).
NEXT_PUBLIC_ONESIGNAL_APP_ID=b09767d8-4bf7-4feb-9ad7-36c833b5f9d4
ONESIGNAL_APP_ID=b09767d8-4bf7-4feb-9ad7-36c833b5f9d4
ONESIGNAL_REST_KEY=        # OneSignal → Settings → Keys & IDs (garder secret)

# ── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://painquotidien.app
NEXT_PUBLIC_INSTAGRAM=lepainquotidien
